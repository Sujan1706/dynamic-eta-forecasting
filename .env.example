# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration (SQLite for 3-Day MVP)
DATABASE_URL=sqlite:///./data/train_eta.db

# Simulator Settings
SIMULATION_TICK_SECONDS=2.0
SIMULATED_MINUTES_PER_TICK=2.0

# Storage Paths
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
MODELS_DIR=./data/models

# RailRadar External API (Optional Plug-in)
RAILRADAR_API_KEY=
RAILRADAR_BASE_URL=https://api.railradar.io
